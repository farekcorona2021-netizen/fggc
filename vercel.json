{
  "headers": [
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    },
    {
      "source": "/(catalog|meta|stream)/:path*",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/resolve", "destination": "/api/resolve" },
    { "source": "/resolve/:path*", "destination": "/api/resolve" },
    { "source": "/catalog/:path*", "destination": "/api/catalog" },
    { "source": "/meta/:path*", "destination": "/api/meta" },
    { "source": "/stream/:path*", "destination": "/api/stream" }
  ]
}
